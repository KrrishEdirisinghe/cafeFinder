# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/cafeFinder
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cafeFinder?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cafeFinder

# API port
PORT=5000

# Comma-separated Vite origins allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
